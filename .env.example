# Environment variables template
# Copy this file to .env and update with your values

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Secret key: set a randomly generated value before deployment
SECRET_KEY=

# SQLite database (defaults to instance/face_emotion_detection.db)
# DATABASE_URL=sqlite:///instance/face_emotion_detection.db

# Set COOKIE_SECURE=true when using HTTPS (production always enables it)
COOKIE_SECURE=false

# Port to run the application
PORT=5000

# Optional: TensorFlow settings
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2
